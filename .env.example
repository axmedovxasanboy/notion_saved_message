CHAT_ID=your_telegram_chat_id

BOT_TOKEN=your_telegram_bot_token

# SQLite storage paths (resolved relative to project root)
DATA_DIR=data
DB_NAME=ai_agent_bot.db

NOTION_TOKEN=your_notion_integration_token
NOTION_MAIN_PAGE_ID=your_notion_main_page_id
NOTION_VERSION=2022-06-28

NOTION_MAIN_WORKSPACE_BUTTON_TEXT='Notion 🖥'
NOTION_BACK_BUTTON_TEXT='Back to main 🖥'

NOTION_CHANNEL_POSTS_PAGE_ID=your_channel_posts_page_id
NOTION_POEMS_PAGE_ID=your_poems_page_id
NOTION_USER_QUOTES_PAGE_ID=your_user_quotes_page_id

OPENAI_API_KEY=sk-proj-...
CLAUDE_API_KEY=sk-ant-api03-...

# ===== Run mode =====
# polling = local development (long polling; no public URL needed)
# webhook = production behind Caddy (pinned to webhook in docker-compose.yml)
RUN_MODE=polling

# ===== Webhook (only used when RUN_MODE=webhook) =====
# Public hostname Caddy terminates TLS for (no scheme, no trailing slash).
WEBHOOK_HOST=bot.example.com
# Internal port the aiohttp server binds on 0.0.0.0 (Caddy proxies to it; the
# port is NOT published to the host).
PORT=8080
# Long random secret. REQUIRED when RUN_MODE=webhook: it is validated on every
# request via the X-Telegram-Bot-Api-Secret-Token header (the webhook path
# itself is a static /webhook — secrets never belong in URLs, they end up in
# access logs). The bot refuses to start without it.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret

# ===== Daily random feed =====
# Timezone the 09:00-21:00 delivery window is measured in. The server clock and
# every stored datetime stay UTC; only this schedule is localised. Any IANA name
# works (Asia/Tashkent, Europe/Istanbul, UTC, ...). Defaults to Asia/Tashkent.
# How many posts per day is set in the bot's Settings screen, not here.
RANDOM_FEED_TZ=Asia/Tashkent

PROMPT_POST_OVERVIEW='...'
MSG_WELCOME='...'
MSG_WELCOME_ADMIN='...'
